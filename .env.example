# ==============================================================================
# YOUTHs CEO Command Center - Environment Variables Template
# ==============================================================================

# Database Configuration (Neon PostgreSQL)
# Under Neon free tier, obtain this from your Neon Console project dashboard.
# If omitted or left empty, the application defaults to an in-memory repository store.
DATABASE_URL="postgresql://user:password@ep-youths-prod.us-east-2.aws.neon.tech/youths_ceo?sslmode=require"

# AI Task Distribution Engine (OpenRouter)
# Required for automated weekly task generation based on member skills and history.
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"
OPENROUTER_FALLBACK_MODEL="meta-llama/llama-3.3-70b-instruct"

# Security & Setup
# Optional bootstrap secret to protect the initial /setup flow in multi-tenant environments.
CEO_SETUP_SECRET=""

# Session Secret (random 32+ character hex string for cookie signing)
SESSION_SECRET="change-this-to-a-secure-random-32-byte-hex-string-in-production"

# Server & Network Configuration
ORIGIN="http://localhost:5173"
PORT="5173"
NODE_ENV="development"

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="YOUTHs <onboarding@resend.dev>"

# Gmail SMTP
SMTP_USER="@gmail.com"
SMTP_PASS="your 16 character app password here"
SMTP_FROM="YOUTHs <@gmail.com>"


{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"noImplicitAny": false,
		"ignoreDeprecations": "6.0",
		"moduleResolution": "bundler",
		"baseUrl": ".",
		"paths": {
			"$lib": ["src/lib"],
			"$lib/*": ["src/lib/*"],
			"#lib": ["src/lib"],
			"#lib/*": ["src/lib/*"]
		}
	},
	"include": [
		"src",
		"vite.config.ts"
	]
}
